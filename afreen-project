      headers: { 'Content-Type': 'application/json' }
    });
    const data = await response.json();
    setBookedRooms(data);
  };

  const handleRandomizeOccupancy = async () => {
    const response = await fetch('/randomize_occupancy');
    const data = await response.json();
    // Handle occupancy logic for the visualization
  };

  const handleResetBooking = async () => {
    const response = await fetch('/reset_booking');
    const data = await response.json();
    setBookedRooms([]);
  };

  return (
    <div className="App">
